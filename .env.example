REVENUECAT_API_KEY=your_read_only_secret_key

# Optional. If omitted, the app reads /v2/projects and uses the first project.
REVENUECAT_PROJECT_ID=
REVENUECAT_CURRENCY=USD

# Optional fallback conversion used if the live FX lookup fails.
# RevenueCat is still queried in USD to avoid duplicate chart API calls.
NEXT_PUBLIC_USD_TO_EUR_RATE=0.92
