REVENUECAT_API_KEY=your_read_only_secret_key

# Optional (preferred for multi-project).
# Expected format: "projectId1:apiKey1,projectId2:apiKey2,..."
REVENUECAT_PROJECT_KEYS=

# Optional. If you provide only one API key (REVENUECAT_API_KEY) for multiple projects,
# you can list project ids here and the same API key will be used for all of them.
# Otherwise keep empty.
REVENUECAT_PROJECT_IDS=

# Optional (for UI): mapping used to show a friendly name per project id.
# Expected format: "projectId1:name1,projectId2:name2,..."
REVENUECAT_PROJECT_NAME_MAP=

# Optional. If omitted, the app reads /v2/projects and uses the first project.
REVENUECAT_PROJECT_ID=
REVENUECAT_CURRENCY=USD
